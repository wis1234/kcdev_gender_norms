. *===============================================================*
. * 8. MANUAL CORRECTIONS - known fuzzy-match errors
. *===============================================================*
. * A handful of schools were matched (by reclink) to the WRONG Giga record.
. * For each one, we look up the CORRECT Giga school (by its real giga_name)
. * in the reference table, and copy ALL of its columns (giga_id, giga_name,
. * lon, lat, giga_level, giga_iso3, giga_country) onto the affected row(s) -
. * not just the name - so the corrected school comes with its own complete,
. * consistent GPS/metadata, and does not end up with a mismatched name/GPS
. * pair. score_flou is set to 1 and statut_match to "manuel" so these rows
. * are traceable to a human-verified correction rather than an automatic
. * match.
. *
. * This section runs AFTER the final merge and BEFORE any export, so the
. * corrections flow through to every downstream file, including
. * Subsets/ecoles_benin_urbain.csv, where the fuzzy-match mistakes were
. * spotted.
. *===============================================================*
. use `apres_fusion', clear

. 
. capture program drop corriger_match

. program define corriger_match
  1.     * nom      : (optionnel) NOMETABLISSEMENT exact de la ligne infra a cor
> riger
.     * ancien   : (optionnel) giga_name actuel (errone) de cette ligne, comme
.     *            verification supplementaire de securite
.     * correct  : (obligatoire) le vrai giga_name a aller chercher dans le
.     *            referentiel Giga pour recopier TOUTES ses colonnes
.     * Au moins un de nom()/ancien() doit etre fourni pour identifier la ligne.
.     syntax , correct(string) [nom(string) ancien(string)]
  2. 
.     if "`nom'" == "" & "`ancien'" == "" {
  3.         display as error "corriger_match: precisez au moins nom() ou ancien
> () pour identifier la ligne a corriger."
  4.         exit 198
  5.     }
  6. 
.     tempvar hit
  7.     quietly gen byte `hit' = 1
  8.     if "`nom'" != "" {
  9.         quietly replace `hit' = 0 if ustrupper(ustrtrim(NOMETABLISSEMENT)) 
> != ustrupper(ustrtrim("`nom'"))
 10.     }
 11.     if "`ancien'" != "" {
 12.         quietly replace `hit' = 0 if ustrupper(ustrtrim(giga_name)) != ustr
> upper(ustrtrim("`ancien'"))
 13.     }
 14. 
.     quietly count if `hit' == 1
 15.     if r(N) == 0 {
 16.         display as error "corriger_match: aucune ligne trouvee pour nom()='
> `nom'' ancien()='`ancien'' - rien n'a ete modifie. Verifiez l'orthographe/l'es
> pacement."
 17.         exit 198
 18.     }
 19.     if r(N) > 1 {
 20.         display as error "corriger_match: " r(N) " lignes trouvees pour nom
> ()='`nom'' ancien()='`ancien'' - condition trop large, precisez-la avant de co
> ntinuer (aucune modification appliquee)."
 21.         exit 198
 22.     }
 23. 
.     * Look up the correct Giga record in the reference table
.     local new_giga_id   ""
 24.     local new_giga_name ""
 25.     local new_lon        = .
 26.     local new_lat         = .
 27.     local new_level     ""
 28.     local new_iso3      ""
 29.     local new_country   ""
 30. 
.     preserve
 31.         * FIX: use the GLOBAL path instead of the (invisible-here) local
.         * `giga_ref' tempfile macro. This is the line that previously
.         * failed with "invalid file specification" (r(198)).
.         use "$giga_ref_path", clear
 32.         keep if ustrupper(ustrtrim(giga_name)) == ustrupper(ustrtrim("`corr
> ect'"))
 33.         quietly count
 34.         if r(N) == 0 {
 35.             display as error "corriger_match: aucune ecole Giga nommee '`co
> rrect'' n'a ete trouvee dans le referentiel giga_ref - correction ignoree."
 36.             restore
 37.             exit 198
 38.         }
 39.         if r(N) > 1 {
 40.             display as error "corriger_match: plusieurs ecoles Giga partage
> nt le nom '`correct'' - desambiguisez par giga_id avant de continuer - correct
> ion ignoree."
 41.             restore
 42.             exit 198
 43.         }
 44.         local new_giga_id   = giga_id[1]
 45.         local new_giga_name = giga_name[1]
 46.         local new_lon       = lon[1]
 47.         local new_lat       = lat[1]
 48.         local new_level     = giga_level[1]
 49.         local new_iso3      = giga_iso3[1]
 50.         local new_country   = giga_country[1]
 51.     restore
 52. 
.     replace giga_id      = "`new_giga_id'"   if `hit' == 1
 53.     replace giga_name    = "`new_giga_name'" if `hit' == 1
 54.     replace lon           = `new_lon'         if `hit' == 1
 55.     replace lat            = `new_lat'         if `hit' == 1
 56.     replace giga_level   = "`new_level'"     if `hit' == 1
 57.     replace giga_iso3    = "`new_iso3'"      if `hit' == 1
 58.     replace giga_country = "`new_country'"   if `hit' == 1
 59.     replace score_flou   = 1                  if `hit' == 1
 60.     replace statut_match = "manuel"          if `hit' == 1
 61. 
.     display as result "corriger_match: 1 ligne corrigee (nom='`nom'' ancien='`
> ancien'') -> giga_name = '`new_giga_name'' (giga_id = `new_giga_id'')."
 62. end

