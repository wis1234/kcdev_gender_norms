. *===============================================================*
. * 2. NAME-CLEANING PROGRAM (reused on both datasets)
. *    - uppercase, accents stripped, punctuation -> space,
. *      multiple spaces collapsed, trimmed
. *===============================================================*
. capture program drop nettoyer_nom

. program define nettoyer_nom
  1.     syntax varname(string), generate(name)
  2.     tempvar tmp1 tmp2
  3.     gen `tmp1' = ustrupper(`varlist')
  4.     * Unicode decomposition, then strip diacritical marks (accents)
.     gen `tmp2' = ustrnormalize(`tmp1', "nfd")
  5.     replace `tmp2' = ustrregexra(`tmp2', "[\u0300-\u036f]", "")
  6.     * Punctuation / hyphens / apostrophes -> space
.     replace `tmp2' = ustrregexra(`tmp2', "[^A-Z0-9]", " ")
  7.     * Multiple spaces -> single space, then trim
.     replace `tmp2' = ustrregexra(`tmp2', " +", " ")
  8.     gen `generate' = ustrtrim(`tmp2')
  9. end

