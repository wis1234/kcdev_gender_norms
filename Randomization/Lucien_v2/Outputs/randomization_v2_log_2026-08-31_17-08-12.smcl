.         capture frame drop arm_draw
{txt}  8{com}. 
.         frame create arm_draw
{txt}  9{com}. 
. 
.         frame arm_draw {c -(}
{txt} 10{com}. 
.             set obs $N_ARMS
{txt} 11{com}. 
