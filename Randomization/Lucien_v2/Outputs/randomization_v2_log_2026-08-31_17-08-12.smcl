{res}  Mother = 26
{txt}
{com}. di as result "  Father = `father_impl'"
{res}  Father = 26
{txt}
{com}. 
. 
. *======================================================================*
. * 7.16 VERIFICATION DES EFFECTIFS DES BRAS TRAITES
. *======================================================================*
. 
. quietly count if group3 == 2
{txt}
{com}. local n_salience = r(N)
{txt}
{com}. 
. quietly count if group3 == 3
{txt}
{com}. local n_impl = r(N)
{txt}
{com}. 
. 
. di as result ""
{res}
{txt}
{com}. di as result "Nombre d'ecoles Salience                  : `n_salience'"
{res}Nombre d'ecoles Salience                  : 52
{txt}
{com}. di as result "Nombre d'ecoles Salience + Implementation : `n_impl'"
{res}Nombre d'ecoles Salience + Implementation : 52
{txt}
{com}. 
. 
. *----------------------------------------------------------------------*
. * Ces assertions sont attendues pour la randomisation actuelle :
. *
. *   Salience = 52
. *   Salience + Implementation = 52
. *----------------------------------------------------------------------*
. 
. assert `n_salience' == 52
{txt}
{com}. assert `n_impl' == 52
{txt}
{com}. 
. 
. *======================================================================*
. * 7.17 CONTROLE GLOBAL MOTHER/FATHER
. *======================================================================*
. 
. assert ///
>     `mother_salience' + `father_salience' == 52
{txt}
{com}. 
. assert ///
>     `mother_impl' + `father_impl' == 52
{txt}
{com}. 
. 
. *----------------------------------------------------------------------*
. * ECART MOTHER/FATHER
. *----------------------------------------------------------------------*
. 
. local diff_sal = ///
>     abs(`mother_salience' - `father_salience')
{txt}
{com}. 
. local diff_impl = ///
>     abs(`mother_impl' - `father_impl')
{txt}
{com}. 
. 
. di as result ""
{res}
{txt}
{com}. di as result "Difference Mother/Father - Salience                  : `diff_sal'"
{res}Difference Mother/Father - Salience                  : 0
{txt}
{com}. di as result "Difference Mother/Father - Salience + Implementation : `diff_impl'"
{res}Difference Mother/Father - Salience + Implementation : 0
{txt}
{com}. 
. 
. *----------------------------------------------------------------------*
. * DIFFERENCE MAXIMALE = 1
. *----------------------------------------------------------------------*
. 
. assert `diff_sal' <= 1
{txt}
{com}. assert `diff_impl' <= 1
{txt}
{com}. 
. 
. *----------------------------------------------------------------------*
. * RESULTAT ATTENDU EXACTEMENT 26/26
. *----------------------------------------------------------------------*
. 
. assert `mother_salience' == 26
{txt}
{com}. assert `father_salience' == 26
{txt}
{com}. 
. assert `mother_impl' == 26
{txt}
{com}. assert `father_impl' == 26
{txt}
{com}. 
. 
. di as result ""
{res}
{txt}
{com}. di as result "======================================================="
{res}=======================================================
{txt}
{com}. di as result "FINAL PARENT BALANCE"
{res}FINAL PARENT BALANCE
{txt}
{com}. di as result "======================================================="
{res}=======================================================
{txt}
{com}. di as result "Salience                   : 26 Mother / 26 Father"
{res}Salience                   : 26 Mother / 26 Father
{txt}
{com}. di as result "Salience + Implementation : 26 Mother / 26 Father"
{res}Salience + Implementation : 26 Mother / 26 Father
{txt}
{com}. di as result "======================================================="
{res}=======================================================
{txt}
{com}. 
. 
. *======================================================================*
. * 7.18 REPRODUCTIBILITE EXACTE DU TIRAGE PARENT
. *
. * Cette section reproduit EXACTEMENT les operations de la section 7.
. *
. * Il est ESSENTIEL de conserver :
. *
. *   1. rand_parent
. *   2. rand_leftover
. *   3. rand_last_leftover
. *
. * dans le meme ordre.
. *======================================================================*
. 
. preserve
{txt}
{com}. 
. 
.     *--------------------------------------------------------------*
.     * A. ETAT INITIAL
.     *--------------------------------------------------------------*
. 
.     sort id_infra
{txt}
{com}. 
.     set seed $SEED_PARENT
{txt}
{com}. 
. 
.     *--------------------------------------------------------------*
.     * B. PREMIER TIRAGE : rand_parent
.     *--------------------------------------------------------------*
. 
.     gen double rand_parent_chk = ///
>         runiform() ///
>         if treated == 1
{txt}(52 missing values generated)

{com}. 
. 
.     *--------------------------------------------------------------*
.     * C. CELLULE BLOC x BRAS
.     *--------------------------------------------------------------*
. 
.     capture drop bloc_arm_chk
{txt}
{com}. 
.     egen long bloc_arm_chk = ///
>         group(bloc group3) ///
>         if treated == 1
{txt}(52 missing values generated)

{com}. 
. 
.     *--------------------------------------------------------------*
.     * D. CLASSEMENT
.     *--------------------------------------------------------------*
. 
.     sort bloc_arm_chk rand_parent_chk
{txt}
{com}. 
. 
.     capture drop rank_parent_chk
{txt}
{com}. 
.     by bloc_arm_chk: gen long rank_parent_chk = ///
>         _n if treated == 1
{txt}(52 missing values generated)

{com}. 
. 
.     capture drop bloc_arm_n_chk
{txt}
{com}. 
.     by bloc_arm_chk: gen long bloc_arm_n_chk = ///
>         _N if treated == 1
{txt}(52 missing values generated)

{com}. 
. 
.     *--------------------------------------------------------------*
.     * E. PARTIE PAIRE
.     *--------------------------------------------------------------*
. 
.     gen byte parent_group_chk = .
{txt}(156 missing values generated)

{com}. 
. 
.     replace parent_group_chk = ///
>         mod(rank_parent_chk - 1, 2) + 1 ///
>         if treated == 1 ///
>         & rank_parent_chk <= ///
>           floor(bloc_arm_n_chk / 2) * 2
{txt}(64 real changes made)

{com}. 
. 
.     *--------------------------------------------------------------*
.     * F. EXCEDENTS
.     *--------------------------------------------------------------*
. 
.     capture drop is_leftover_chk
{txt}
{com}. 
.     gen byte is_leftover_chk = ///
>         treated == 1 ///
>         & mod(bloc_arm_n_chk, 2) == 1 ///
>         & rank_parent_chk == bloc_arm_n_chk
{txt}
{com}. 
. 
.     *--------------------------------------------------------------*
.     * G. NOMBRE D'EXCEDENTS PAR BRAS
.     *--------------------------------------------------------------*
. 
.     capture drop n_leftover_arm_chk
{txt}
{com}. 
.     bysort group3: egen long n_leftover_arm_chk = ///
>         total(is_leftover_chk)
{txt}
{com}. 
. 
.     *--------------------------------------------------------------*
.     * H. DEUXIEME TIRAGE : rand_leftover
.     *--------------------------------------------------------------*
. 
.     gen double rand_leftover_chk = ///
>         runiform() ///
>         if is_leftover_chk == 1
{txt}(116 missing values generated)

{com}. 
. 
.     *--------------------------------------------------------------*
.     * I. CLASSEMENT DES EXCEDENTS
.     *
.     * IMPORTANT :
.     * sum(is_leftover_chk), pas _n.
.     *--------------------------------------------------------------*
. 
.     sort group3 rand_leftover_chk
{txt}
{com}. 
. 
.     capture drop rank_leftover_chk
{txt}
{com}. 
.     by group3: gen long rank_leftover_chk = ///
>         sum(is_leftover_chk)
{txt}
{com}. 
.     replace rank_leftover_chk = . ///
>         if is_leftover_chk != 1
{txt}(116 real changes made, 116 to missing)

{com}. 
. 
.     *--------------------------------------------------------------*
.     * J. ATTRIBUTION DES EXCEDENTS
.     *--------------------------------------------------------------*
. 
.     replace parent_group_chk = ///
>         mod(rank_leftover_chk - 1, 2) + 1 ///
>         if is_leftover_chk == 1 ///
>         & rank_leftover_chk <= ///
>           floor(n_leftover_arm_chk / 2) * 2
{txt}(40 real changes made)

{com}. 
. 
.     *--------------------------------------------------------------*
.     * K. TROISIEME TIRAGE
.     *--------------------------------------------------------------*
. 
.     gen double rand_last_leftover_chk = ///
>         runiform() ///
>         if is_leftover_chk == 1 ///
>         & mod(n_leftover_arm_chk, 2) == 1 ///
>         & rank_leftover_chk == n_leftover_arm_chk
{txt}(156 missing values generated)

{com}. 
. 
.     *--------------------------------------------------------------*
.     * L. DERNIER EXCEDENT
.     *--------------------------------------------------------------*
. 
.     replace parent_group_chk = ///
>         cond(rand_last_leftover_chk < 0.5, 1, 2) ///
>         if is_leftover_chk == 1 ///
>         & mod(n_leftover_arm_chk, 2) == 1 ///
>         & rank_leftover_chk == n_leftover_arm_chk
{txt}(0 real changes made)

{com}. 
. 
.     *--------------------------------------------------------------*
.     * M. VERIFICATION
.     *--------------------------------------------------------------*
. 
.     quietly count if treated == 1 ///
>         & missing(parent_group_chk)
{txt}
{com}. 
.     assert r(N) == 0
{txt}
{com}. 
. 
.     quietly count if treated == 1 ///
>         & parent_group != parent_group_chk
{txt}
{com}. 
.     local n_parent_diff = r(N)
{txt}
{com}. 
. 
.     di as result ""
{res}
{txt}
{com}.     di as result "======================================================="
{res}=======================================================
{txt}
{com}.     di as result "REPRODUCTIBILITE PARENT"
{res}REPRODUCTIBILITE PARENT
{txt}
{com}.     di as result "======================================================="
{res}=======================================================
{txt}
{com}.     di as result "Nombre de differences : `n_parent_diff'"
{res}Nombre de differences : 24
{txt}
{com}. 
. 
.     assert `n_parent_diff' == 0
{err}assertion is false
{txt}{search r(9), local:r(9);}

end of do-file

{search r(9), local:r(9);}

{com}. 

