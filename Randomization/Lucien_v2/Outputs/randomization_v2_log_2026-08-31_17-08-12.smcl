. *======================================================================*
. * 6.2 REPRODUCTIBILITE DE LA RANDOMISATION DES BRAS
. *======================================================================*
. 
. preserve
{txt}
{com}. 
.     sort id_infra
{txt}
{com}. 
.     set seed $SEED_ARMS
{txt}
{com}. 
. 
.     gen double rand_arm_chk = ///
>         runiform()
