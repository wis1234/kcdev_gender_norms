{res}Taille minimale : 
{txt}
{com}. 
. di as result ///
>     "Taille maximale : `r(max)'"
{res}Taille maximale : 
{txt}
{com}. 
. isid id_infra
{txt}
{com}. 
. quietly count if missing(bloc)
{txt}
{com}. 
. assert r(N) == 0
{txt}
{com}. 
