. *======================================================================*
. * 6.1 CONTROLE INFORMATIONNEL DES PETITS BLOCS
. *======================================================================*
. 
. preserve
{txt}
{com}. 
.     contract bloc group3, freq(narm)
{txt}
{com}. 
.     bysort bloc: egen narm_min = ///
>         min(narm)
{txt}
{com}. 
.     quietly count if narm_min < 2
{txt}
{com}. 
.     di as result ""
{res}
