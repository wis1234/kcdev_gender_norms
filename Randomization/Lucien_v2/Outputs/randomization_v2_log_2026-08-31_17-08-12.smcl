.             gen double u = ///
>                 runiform()
{txt} 13{com}. 
.             sort u
{txt} 14{com}.         {c )-}
{txt} 15{com}. 
. 
.         local chosen ""
{txt} 16{com}. 
.         forvalues i = 1/`rem' {c -(}
{txt} 17{com}. 
.             frame arm_draw: ///
>                 local this_arm = arm_id[`i']
{txt} 18{com}. 
