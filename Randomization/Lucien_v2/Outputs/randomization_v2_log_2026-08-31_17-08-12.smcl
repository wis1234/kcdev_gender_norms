. *======================================================================*
. * 7. RANDOMISATION DU PARENT
. *
. * OBJECTIF :
. *
. *   - randomisation imbriquee dans BLOC x BRAS ;
. *
. *   - Control exclu ;
. *
. *   - 50/50 dans chaque cellule bloc x bras autant que possible ;
. *
. *   - chaque cellule impaire produit un excedent ;
. *
. *   - les excedents sont regroupes SEPAREMENT par bras traite ;
. *
. *   - les excedents sont randomises ;
. *
. *   - alternance Mother / Father ;
. *
. *   - si nombre impair d'excedents :
. *       dernier excedent tire aleatoirement ;
. *
. *   - avec 52 ecoles par bras :
. *       26 Mother / 26 Father dans chaque bras.
. *======================================================================*
. 
. 
. *----------------------------------------------------------------------*
. * 7.1 IDENTIFICATION DES ECOLES TRAITEES
. *----------------------------------------------------------------------*
. 
. capture drop treated
{txt}
{com}. 
. gen byte treated = ///
>     inlist(group3, 2, 3)
{txt}
{com}. 
. label var treated ///
>     "1 = ecole traitee"
{txt}
{com}. 
. 
. *----------------------------------------------------------------------*
. * 7.2 PREMIER TIRAGE ALEATOIRE
. *----------------------------------------------------------------------*
. 
. sort id_infra
{txt}
{com}. 
. set seed $SEED_PARENT
{txt}
{com}. 
. 
. capture drop rand_parent
{txt}
{com}. 
. gen double rand_parent = ///
>     runiform() ///
>     if treated == 1
{txt}(52 missing values generated)

{com}. 
. 
. *----------------------------------------------------------------------*
. * 7.3 CELLULE BLOC x BRAS
. *----------------------------------------------------------------------*
. 
. capture drop bloc_arm
{txt}
{com}. 
. egen long bloc_arm = ///
>     group(bloc group3) ///
>     if treated == 1
{txt}(52 missing values generated)

{com}. 
. label var bloc_arm ///
>     "Cellule de randomisation parent : bloc x bras"
{txt}
{com}. 
. 
. *----------------------------------------------------------------------*
. * 7.4 RANDOMISATION DANS CHAQUE CELLULE
. *----------------------------------------------------------------------*
. 
. sort bloc_arm rand_parent
{txt}
{com}. 
. 
. capture drop rank_parent
{txt}
{com}. 
. by bloc_arm: gen long rank_parent = ///
>     _n if treated == 1
{txt}(52 missing values generated)

{com}. 
. 
. capture drop bloc_arm_n
{txt}
{com}. 
. by bloc_arm: gen long bloc_arm_n = ///
>     _N if treated == 1
{txt}(52 missing values generated)

{com}. 
. 
. *======================================================================*
. * 7.5 ATTRIBUTION 50/50 DE LA PARTIE PAIRE
. *======================================================================*
. 
. capture drop parent_group
{txt}
{com}. 
. gen byte parent_group = .
{txt}(156 missing values generated)

{com}. 
. 
. replace parent_group = ///
>     mod(rank_parent - 1, 2) + 1 ///
>     if treated == 1 ///
>     & rank_parent <= ///
>       floor(bloc_arm_n / 2) * 2
{txt}(64 real changes made)

{com}. 
. 
. *======================================================================*
. * 7.6 IDENTIFICATION DES EXCEDENTS
. *======================================================================*
. *
. * Une cellule impaire produit UNE seule ecole excedentaire.
. *
. * Exemple :
. *
. *   6 ecoles -> 3 Mother / 3 Father
. *   5 ecoles -> 2 Mother / 2 Father + 1 excedent
. *   4 ecoles -> 2 Mother / 2 Father
. *   3 ecoles -> 1 Mother / 1 Father + 1 excedent
. *======================================================================*
. 
. capture drop is_leftover
{txt}
{com}. 
. gen byte is_leftover = ///
>     treated == 1 ///
>     & mod(bloc_arm_n, 2) == 1 ///
>     & rank_parent == bloc_arm_n
{txt}
{com}. 
. label var is_leftover ///
>     "1 = ecole excedentaire d'une cellule impaire"
{txt}
{com}. 
. 
. *======================================================================*
. * 7.7 NOMBRE D'EXCEDENTS PAR BRAS
. *======================================================================*
. 
. capture drop n_leftover_arm
{txt}
{com}. 
. bysort group3: egen long n_leftover_arm = ///
>     total(is_leftover)
{txt}
{com}. 
. 
. *======================================================================*
. * 7.8 DEUXIEME TIRAGE ALEATOIRE
. *
. * IMPORTANT :
. * Ce tirage est separe du premier tirage rand_parent.
. *
. * Il permet de randomiser l'ordre des excedents.
. *======================================================================*
. 
. capture drop rand_leftover
{txt}
{com}. 
. gen double rand_leftover = ///
>     runiform() ///
>     if is_leftover == 1
{txt}(116 missing values generated)

{com}. 
. 
. *======================================================================*
. * 7.9 CLASSEMENT DES EXCEDENTS
. *
. * IMPORTANT :
. * On utilise sum(is_leftover), et NON _n.
. *
. * Cela garantit que rank_leftover correspond uniquement aux excedents.
. *======================================================================*
. 
. sort group3 rand_leftover
{txt}
{com}. 
. 
. capture drop rank_leftover
{txt}
{com}. 
. by group3: gen long rank_leftover = ///
>     sum(is_leftover)
{txt}
{com}. 
. replace rank_leftover = . ///
>     if is_leftover != 1
{txt}(116 real changes made, 116 to missing)

{com}. 
. 
. *======================================================================*
. * 7.10 ATTRIBUTION DES EXCEDENTS PAR ALTERNANCE
. *
. * 1 -> Mother
. * 2 -> Father
. * 3 -> Mother
. * 4 -> Father
. * ...
. *======================================================================*
. 
. replace parent_group = ///
>     mod(rank_leftover - 1, 2) + 1 ///
>     if is_leftover == 1 ///
>     & rank_leftover <= ///
>       floor(n_leftover_arm / 2) * 2
{txt}(40 real changes made)

{com}. 
. 
. *======================================================================*
. * 7.11 CAS D'UN NOMBRE IMPAIR D'EXCEDENTS
. *
. * Le dernier excedent est tire aleatoirement entre :
. *
. *   1 = Mother
. *   2 = Father
. *
. * Difference maximale = 1.
. *======================================================================*
. 
. capture drop rand_last_leftover
{txt}
{com}. 
. gen double rand_last_leftover = ///
>     runiform() ///
>     if is_leftover == 1 ///
>     & mod(n_leftover_arm, 2) == 1 ///
>     & rank_leftover == n_leftover_arm
{txt}(156 missing values generated)

{com}. 
. 
. replace parent_group = ///
>     cond(rand_last_leftover < 0.5, 1, 2) ///
>     if is_leftover == 1 ///
>     & mod(n_leftover_arm, 2) == 1 ///
>     & rank_leftover == n_leftover_arm
{txt}(0 real changes made)

{com}. 
. 
. *======================================================================*
. * 7.12 LABELS
. *======================================================================*
. 
. label define parent_lbl ///
>     1 "Mother" ///
>     2 "Father", ///
>     replace
{txt}
{com}. 
. label values parent_group parent_lbl
{txt}
{com}. 
. label var parent_group ///
>     "Targeted parent: Mother/Father"
{txt}
{com}. 
. 
