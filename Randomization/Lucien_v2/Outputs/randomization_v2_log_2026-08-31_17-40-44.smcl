{res}=======================================================
{txt}
{com}. di as result "BLOCS FINAUX"
{res}BLOCS FINAUX
{txt}
{com}. di as result "======================================================="
{res}=======================================================
{txt}
{com}. 
. quietly levelsof bloc, local(blist)
{txt}
{com}. 
. di as result ///
>     "Nombre de blocs : `: word count `blist''"
{res}Nombre de blocs : 37
{txt}
{com}. 
. di as result ///
>     "Taille minimale : `r(min)'"
{res}Taille minimale : 
{txt}
{com}. 
. di as result ///
>     "Taille maximale : `r(max)'"
{res}Taille maximale : 
{txt}
{com}. 
. isid id_infra
{txt}
{com}. 
. quietly count if missing(bloc)
{txt}
{com}. 
. assert r(N) == 0
{txt}
{com}. 
. 
