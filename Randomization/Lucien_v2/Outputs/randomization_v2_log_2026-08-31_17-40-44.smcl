{com}. di as result "Salience                  : `n_salience'"
{res}Salience                  : 52
{txt}
{com}. di as result "Salience + Implementation : `n_impl'"
{res}Salience + Implementation : 52
{txt}
{com}. 
. 
. *----------------------------------------------------------------------*
. * VERIFICATION ATTENDUE
. *----------------------------------------------------------------------*
. 
. assert `n_salience' == 52
{txt}
{com}. assert `n_impl' == 52
{txt}
{com}. 
. 
. *======================================================================*
. * 7.19 RESULTATS MOTHER / FATHER
. *======================================================================*
. 
. di as result ""
{res}
{txt}
{com}. di as result "======================================================="
{res}=======================================================
{txt}
{com}. di as result "RESULTATS PARENT"
{res}RESULTATS PARENT
{txt}
{com}. di as result "======================================================="
{res}=======================================================
{txt}
{com}. 
. di as result ""
{res}
{txt}
{com}. di as result "Salience :"
{res}Salience :
{txt}
{com}. di as result "  Mother = `mother_salience'"
{res}  Mother = 26
{txt}
{com}. di as result "  Father = `father_salience'"
{res}  Father = 26
{txt}
{com}. 
. di as result ""
{res}
{txt}
{com}. di as result "Salience + Implementation :"
{res}Salience + Implementation :
{txt}
{com}. di as result "  Mother = `mother_impl'"
{res}  Mother = 26
{txt}
{com}. di as result "  Father = `father_impl'"
{res}  Father = 26
{txt}
{com}. 
. 
. *----------------------------------------------------------------------*
. * VERIFICATION DES TOTAUX
. *----------------------------------------------------------------------*
. 
. assert ///
>     `mother_salience' + `father_salience' == 52
{txt}
{com}. 
. assert ///
>     `mother_impl' + `father_impl' == 52
{txt}
{com}. 
. 
. *----------------------------------------------------------------------*
. * ECART MOTHER / FATHER
. *----------------------------------------------------------------------*
. 
. local diff_sal = ///
>     abs(`mother_salience' - `father_salience')
{txt}
{com}. 
. local diff_impl = ///
>     abs(`mother_impl' - `father_impl')
{txt}
{com}. 
. 
. di as result ""
{res}
{txt}
{com}. di as result "Difference Salience                  : `diff_sal'"
{res}Difference Salience                  : 0
{txt}
{com}. di as result "Difference Salience + Implementation : `diff_impl'"
{res}Difference Salience + Implementation : 0
{txt}
{com}. 
. 
. *----------------------------------------------------------------------*
. * EQUILIBRE MAXIMAL
. *----------------------------------------------------------------------*
. 
. assert `diff_sal' <= 1
{txt}
{com}. assert `diff_impl' <= 1
{txt}
{com}. 
. 
. *======================================================================*
. * 7.20 CONTROLE EXACT 26 / 26
. *======================================================================*
. *
. * Puisque chaque bras traite comporte 52 ecoles, le meilleur equilibre
. * possible est exactement :
. *
. *       26 Mother
. *       26 Father
. *
. *----------------------------------------------------------------------*
. 
. assert `mother_salience' == 26
{txt}
{com}. assert `father_salience' == 26
{txt}
{com}. 
. assert `mother_impl' == 26
{txt}
{com}. assert `father_impl' == 26
{txt}
{com}. 
. 
. di as result ""
{res}
{txt}
{com}. di as result "======================================================="
{res}=======================================================
{txt}
{com}. di as result "FINAL PARENT BALANCE"
{res}FINAL PARENT BALANCE
{txt}
{com}. di as result "======================================================="
{res}=======================================================
{txt}
{com}. 
. di as result ///
>     "Salience                  : 26 Mother / 26 Father"
{res}Salience                  : 26 Mother / 26 Father
{txt}
{com}. 
. di as result ///
>     "Salience + Implementation : 26 Mother / 26 Father"
{res}Salience + Implementation : 26 Mother / 26 Father
{txt}
{com}. 
. di as result "======================================================="
{res}=======================================================
{txt}
{com}. 
. 
. *======================================================================*
. * 7.21 CONTROLES DE COHERENCE INTERNES
. *======================================================================*
. 
. *----------------------------------------------------------------------*
. * Toutes les ecoles traitees doivent avoir un parent.
. *----------------------------------------------------------------------*
. 
. quietly count if treated == 1 & missing(parent_group)
{txt}
{com}. 
. assert r(N) == 0
{txt}
{com}. 
. 
. *----------------------------------------------------------------------*
. * Aucune ecole Control ne doit avoir de parent.
. *----------------------------------------------------------------------*
. 
. quietly count if treated == 0 & !missing(parent_group)
{txt}
{com}. 
. assert r(N) == 0
{txt}
{com}. 
. 
. *----------------------------------------------------------------------*
. * Toutes les cellules bloc x bras traitees doivent avoir une
. * attribution parent.
. *----------------------------------------------------------------------*
. 
. quietly count if treated == 1 & missing(bloc_arm)
{txt}
{com}. 
. assert r(N) == 0
{txt}
{com}. 
. 
. *----------------------------------------------------------------------*
. * Toutes les cellules paires sont exactement 50/50.
. *----------------------------------------------------------------------*
. 
. preserve
{txt}
{com}. 
.     contract bloc_arm parent_group ///
>         if treated == 1, ///
>         freq(n)
{txt}
{com}. 
.     bysort bloc_arm: egen cell_min = min(n)
{txt}
{com}.     bysort bloc_arm: egen cell_max = max(n)
{txt}
{com}. 
.     quietly count if cell_min != cell_max
{txt}
{com}. 
.     local unequal_even = r(N)
{txt}
{com}. 
. restore
{txt}
{com}. 
. 
. di as result ""
{res}
{txt}
{com}. di as result ///
>     "Controle des cellules bloc x bras termine."
{res}Controle des cellules bloc x bras termine.
{txt}
{com}. 
. 
